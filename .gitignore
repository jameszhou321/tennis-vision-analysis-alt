# ===== Large Files / Datasets (Excluded from Version Control) =====
# Original competition videos, subtitles
videos/
*.mp4
*.avi
*.mkv
*.ass
*.srt

# Datasets (Annotated rounds, court/personnel training data, etc.)
data/
*.zip

# Model weights
models/
*.pt
*.pth
*.onnx
*.engine

# Training run records, logs, outputs, results
runs/
logs/
results/
journal/
_archive/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# ===== Tools / Annotation Artifacts =====
_progress.json
last_session.json
annotations.json
pose_data.json
tracking_data.json

# ===== IDEs / System Files =====
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ===== Claude Code (personal overrides) =====
.claude/settings.local.json
.claude/*.graphify-bak

# ===== graphify (local/regenerable artifacts; graph.json itself is tracked
# for the git merge=graphify driver in .gitattributes) =====
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_root
graphify-out/.graphify_python